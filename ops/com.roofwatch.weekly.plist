<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- __REPO__ is replaced with the repository path by ops/install_schedule.sh -->
<dict>
  <key>Label</key><string>com.roofwatch.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>__REPO__/run_weekly.py</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Mondays 07:00. launchd runs a missed job when the Mac wakes. -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/outputs/launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO__/outputs/launchd.log</string>
</dict>
</plist>
